# ---------------------------------------------------------------------------
# Google Sheets data source
# ---------------------------------------------------------------------------
# Leave SHEET_ID unset to run entirely on the committed snapshot in
# lib/data/seed.ts (fine for local dev and the first deploy).
#
# Set SHEET_ID to the workbook's file id to read the LIVE tabs. The workbook
# must be shared so that "Anyone with the link" can VIEW it (or Published to
# the web). No API key, no OAuth — the app fetches each tab as CSV from:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/gviz/tq?tqx=out:csv&sheet=<TAB>
#
# The id is the long string in the sheet URL:
#   https://docs.google.com/spreadsheets/d/ 1AbC...XyZ /edit
#                                           ^^^^^^^^^^^ this part
#
# Tab names must match exactly: LEAGUE_STATUS, L_CAREERS, CHAMPIONS, AWARDS,
# HALL_OF_FAME, L_RECORDS, L_EVENTS, X_PERSONALITIES
#
# Live data is cached for 5 minutes (revalidate) so edits show up shortly after.

# SHEET_ID=

# ---------------------------------------------------------------------------
# AI news + social generation  (build/CI time only — never used by the app runtime)
# ---------------------------------------------------------------------------
# Used by `npm run generate:news` / `npm run generate:social` and by the
# GitHub Action. Put the real value in .env.local locally (gitignored) and in
# GitHub -> Settings -> Secrets -> Actions as ANTHROPIC_API_KEY.
#
# Optional overrides (all default sensibly):
#   NEWS_MODEL / SOCIAL_MODEL   default claude-opus-5
#   NEWS_EFFORT                 default medium   (low | medium | high | xhigh | max)
#   SOCIAL_EFFORT              default low

# ANTHROPIC_API_KEY=
# NEWS_MODEL=claude-opus-5
# SOCIAL_MODEL=claude-opus-5
# NEWS_EFFORT=medium
# SOCIAL_EFFORT=low

# ---------------------------------------------------------------------------
# Google Drive photo linkage (DRIVE_ID column -> photo on the story/card)
# ---------------------------------------------------------------------------
# A Google API key with the Drive API enabled. Lists the shared photo folder to
# map "1","2","3" -> real file ids. No OAuth; works on a link-shared folder.
#   - Local + GitHub Action: needed to (re)build data/generated/driveMap.json.
#   - Vercel: optional. If set, the app lists the folder live (photos appear in
#     ~5 min). If not set, the app uses the committed driveMap.json (photos
#     appear on the next generation run).
# DRIVE_FOLDER_ID overrides the hardcoded folder id if it ever changes.

# GOOGLE_API_KEY=
# DRIVE_FOLDER_ID=1_avv4iKMne5Zh9SgHYnWC3BNq-0IPzGw
